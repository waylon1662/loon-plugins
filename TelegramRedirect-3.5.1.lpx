#!name=Telegram 重定向（Swiftgram 专用）
#!desc=将 t.me 链接重定向至 Swiftgram，适配 Loon 3.5.1+
#!author=OpenAI
#!loon_version=3.5.1(978)

[MITM]
hostname = %APPEND% t.me, telegram.me

[Rewrite]
# 普通用户名链接
request if ${url} ~= /^https:\/\/(?:www\.)?(?:t\.me|telegram\.me)\/([A-Za-z][A-Za-z0-9_]{3,30}[A-Za-z0-9])\/?(?:\?.*)?$/ as item then redirect(307, "sg://resolve?domain=${item.1}")

# 频道或群组消息链接
request if ${url} ~= /^https:\/\/(?:www\.)?(?:t\.me|telegram\.me)\/([A-Za-z][A-Za-z0-9_]{3,30}[A-Za-z0-9])\/([0-9]+)\/?(?:\?.*)?$/ as item then redirect(307, "sg://resolve?domain=${item.1}&post=${item.2}")

# 私有邀请链接
request if ${url} ~= /^https:\/\/(?:www\.)?(?:t\.me|telegram\.me)\/\+([A-Za-z0-9_-]+)\/?(?:\?.*)?$/ as item then redirect(307, "sg://join?invite=${item.1}")

# 旧格式私有邀请链接
request if ${url} ~= /^https:\/\/(?:www\.)?(?:t\.me|telegram\.me)\/joinchat\/([A-Za-z0-9_-]+)\/?(?:\?.*)?$/ as item then redirect(307, "sg://join?invite=${item.1}")
